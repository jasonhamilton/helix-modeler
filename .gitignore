# caches and large local data
cache/
*.wav
*.flac
*.mp3
*.aiff
!fixtures/smoke/*.wav

# user-exported Line 6 presets and catalogs stay local by default
fixtures/golden/*.hlx
cache/catalog/

# listening sessions and answer keys
sessions/

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
fixtures/smoke/*.hlx

# local DI library (T021): everything except the README stays local
data/di/**
!data/di/README.md
*.aif

# user-supplied songs for local testing only (never committed, never uploaded)
data/songs/

# internal-only reports (block/model coverage): never committed
reports/local/

# user-exported Line 6 setlists and preset folders stay local
fixtures/golden/*.hls
fixtures/golden/setlists/
fixtures/golden/presets/
